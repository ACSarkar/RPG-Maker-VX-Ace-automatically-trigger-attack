#Allows for a skill to automatically activate upon selection.

#If you want a skill to autimatically activate, write "<AUTOSEND>" in its
# note tags.
class RPG::Skill < RPG::UsableItem
  def canAutoSend
    regexp = /<AUTOSEND>/
    return self.note.match(regexp)
  end
end

#Automatically uses skill on selection, if it has the appropriate tag.
class Scene_Battle < Scene_Base
  def autoSend
    item = BattleManager.actor.input.item
    return unless item.is_a?(RPG::Skill) && item.canAutoSend
    @subject = BattleManager.actor
    execute_action
    process_action_end
    process_event   #Activate any battle events that may have triggered.
    refresh_status
    @status_window.unselect
    @status_window.open
    @subject.input.clear  
    subject = nil
        
    prior_command #Gives back turn to the unit who used the skill.
  end

  #When selecting an enemy to target with a skill, checks to see if the skill
  # should automatically activate.
  def on_enemy_ok
    BattleManager.actor.input.target_index = @enemy_window.enemy.index
    @enemy_window.hide
    @skill_window.hide
    @item_window.hide
    autoSend
    next_command
  end
  
  #When selecting an ally to target with a skill, checks to see if the skill
  # should automatically activate.
  def on_actor_ok
    BattleManager.actor.input.target_index = @actor_window.index
    @actor_window.hide
    @skill_window.hide
    @item_window.hide
    autoSend
    next_command
  end
end

#This code exists to prevent a certain visual error. 
class Scene_Battle < Scene_Base
  alias autosend_start_actor_command_selection start_actor_command_selection
  def start_actor_command_selection
    @party_command_window.deactivate
    autosend_start_actor_command_selection
  end
end
